# bump: libgit2-version /LIBGIT2_VERSION="(.*)"/ https://github.com/libgit2/libgit2.git|*
LIBGIT2_VERSION="1.9.0"

export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="development library"
export ZOPEN_STABLE_URL="https://github.com/libgit2/libgit2/archive/refs/tags/v${LIBGIT2_VERSION}.tar.gz"
# libssh2, openssl, and zlib are all in zopencommunity; regex uses libgit2's bundled PCRE
export ZOPEN_STABLE_DEPS="cmake make zoslib openssl zlib libssh2 pkgconfig"

export ZOPEN_COMP=CLANG

# On z/OS, set feature-test macros to unlock POSIX types (ssize_t, SIZE_MAX).
# Force-include stdbool.h for bool in C files.
#
# Do NOT use -D_POSIX_C_SOURCE=200809L: it sets __SUSV4_POSIX which causes
# the system string.h to declare stpcpy via __new4302(), then zoslib's
# string.h redeclares it with __attribute__((visibility("default"))) — a
# "different kind of symbol" error in ibm-clang64. _XOPEN_SOURCE=600 is
# sufficient and does NOT trigger __SUSV4_POSIX.
#
# Do NOT use -include sys/types.h: the zopen prefix (/usr/local/include)
# and the zoslib include path both have sys/types.h wrappers that share
# the same include guard (ZOS_SYS_TYPES_H). When both are in the -isystem
# path (as CMake adds the prefix via CMAKE_PREFIX_PATH), the guard collision
# prevents the system sys/types.h from being reached, so ssize_t stays
# undefined. Use a bundled zos_types.h that defines ssize_t directly.
export ZOPEN_EXTRA_CFLAGS="-include zos_types.h -include stddef.h -include stdbool.h -D_OPEN_SYS_FILE_EXT=1 -D_XOPEN_SOURCE=600"
export ZOPEN_EXTRA_CXXFLAGS="-include zos_types.h -include stddef.h -include stdbool.h -D_OPEN_SYS_FILE_EXT=1 -D_XOPEN_SOURCE=600"

export ZOPEN_CONFIGURE="cmake"
# CMAKE_PREFIX_PATH is intentionally omitted: it adds /usr/local/include
# to the isystem path, which contains zoslib wrapper headers that share
# include guards with the zoslib originals in the separate zoslib isystem
# path. The duplicate guards cause include_next chains to short-circuit,
# leaving types like time_t and ssize_t undefined.
# Libraries are found via PKG_CONFIG_PATH (set by zopen-config) instead.
export ZOPEN_CONFIGURE_OPTS="-S . -B build \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=\$ZOPEN_INSTALL_DIR \
  -DCMAKE_C_COMPILER=ibm-clang64 \
  -DCMAKE_CXX_COMPILER=ibm-clang++64 \
  -DCMAKE_C_STANDARD=99 \
  -DBUILD_SHARED_LIBS=ON \
  -DBUILD_TESTS=OFF \
  -DBUILD_CLI=OFF \
  -DBUILD_EXAMPLES=OFF \
  -DUSE_SSH=libssh2 \
  -DUSE_HTTPS=OpenSSL \
  -DUSE_SHA1=CollisionDetection \
  -DUSE_COMPRESSION=zlib \
  -DUSE_NSEC=OFF \
  -DUSE_THREADS=pthreads \
  -DTHREADS_FOUND=TRUE \
  -DCMAKE_HAVE_PTHREAD_CREATE=TRUE \
  -DTHREADS_HAVE_PTHREAD_ARG=OFF \
  -DCMAKE_THREAD_LIBS_INIT=\"\" \
  -DREGEX_BACKEND=builtin"

zopen_pre_build()
{
  # Copy zos_types.h into the source tree so that -include zos_types.h
  # (in ZOPEN_EXTRA_CFLAGS) can resolve it via the cmake -isystem src/util path.
  if [ -f "${ZOPEN_ROOT}/zos_types.h" ]; then
    cp "${ZOPEN_ROOT}/zos_types.h" ./src/util/zos_types.h
    chtag -tc ISO8859-1 ./src/util/zos_types.h
    echo "z/OS type fixup header installed to src/util/zos_types.h"
  fi
}

export ZOPEN_MAKE="cmake"
export ZOPEN_MAKE_OPTS="--build build"
# Prevent zopen from appending CC=...CFLAGS=... to cmake commands
export ZOPEN_MAKE_MINIMAL="yes"

export ZOPEN_INSTALL="cmake"
export ZOPEN_INSTALL_OPTS="--install build"
export ZOPEN_INSTALL_MINIMAL="yes"

zopen_check_results()
{
  dir="$1"
  pfx="$2"

  # Check runs after build but before install; verify library in cmake build/ dir.
  if [ -f "./build/libgit2.so" ] || [ -f "./build/libgit2.a" ] || [ -f "./build/libgit2.x" ]; then
    actualFailures=0
    totalTests=1
    expectedFailures=0
  else
    actualFailures=1
    totalTests=1
    expectedFailures=0
  fi

  cat <<ZZ
actualFailures:$actualFailures
totalTests:$totalTests
expectedFailures:$expectedFailures
ZZ
}

zopen_append_to_env()
{
cat <<ZZ
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lgit2"
fi
ZZ
}

zopen_get_version()
{
  echo "${LIBGIT2_VERSION}"
}
