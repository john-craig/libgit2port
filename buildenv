# bump: libgit2-version /LIBGIT2_VERSION="(.*)"/ https://github.com/libgit2/libgit2.git|*
LIBGIT2_VERSION="1.9.0"

export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_CATEGORIES="development library"
export ZOPEN_STABLE_URL="https://github.com/libgit2/libgit2/archive/refs/tags/v${LIBGIT2_VERSION}.tar.gz"
# libssh2, openssl, and zlib are all in zopencommunity; regex uses libgit2's bundled PCRE
export ZOPEN_STABLE_DEPS="cmake make zoslib openssl zlib libssh2 pkgconfig"

export ZOPEN_COMP=CLANG

# On z/OS, set feature-test macros to unlock POSIX types (ssize_t, SIZE_MAX).
# Force-include stdbool.h for bool in C files.
# Do NOT force sys/types.h, limits.h, or _POSIX_C_SOURCE=200809L:
#   _POSIX_C_SOURCE=200809L sets __SUSV4_POSIX which causes the system
#   string.h to declare stpcpy via __new4302(), then zoslib's string.h
#   redeclares it with __attribute__((visibility("default"))) — a "different
#   kind of symbol" error in ibm-clang64. _XOPEN_SOURCE=600 is sufficient
#   and does NOT trigger __SUSV4_POSIX.
export ZOPEN_EXTRA_CFLAGS="-include stddef.h -include stdbool.h -D_OPEN_SYS_FILE_EXT=1 -D_XOPEN_SOURCE=600"
export ZOPEN_EXTRA_CXXFLAGS="-include stddef.h -include stdbool.h -D_OPEN_SYS_FILE_EXT=1 -D_XOPEN_SOURCE=600"

export ZOPEN_CONFIGURE="cmake"
export ZOPEN_CONFIGURE_OPTS="-S . -B build \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=\$ZOPEN_INSTALL_DIR \
  -DCMAKE_PREFIX_PATH=/u/jcraig/zopen/usr/local \
  -DCMAKE_C_COMPILER=ibm-clang64 \
  -DCMAKE_CXX_COMPILER=ibm-clang++64 \
  -DBUILD_SHARED_LIBS=ON \
  -DBUILD_TESTS=OFF \
  -DBUILD_CLI=OFF \
  -DBUILD_EXAMPLES=OFF \
  -DUSE_SSH=libssh2 \
  -DUSE_HTTPS=OpenSSL \
  -DUSE_SHA1=CollisionDetection \
  -DUSE_COMPRESSION=zlib \
  -DUSE_NSEC=OFF \
  -DUSE_THREADS=pthreads \
  -DTHREADS_FOUND=TRUE \
  -DCMAKE_HAVE_PTHREAD_CREATE=TRUE \
  -DTHREADS_HAVE_PTHREAD_ARG=OFF \
  -DCMAKE_THREAD_LIBS_INIT="" \
  -DREGEX_BACKEND=builtin"

export ZOPEN_MAKE="cmake"
export ZOPEN_MAKE_OPTS="--build build"
# Prevent zopen from appending CC=...CFLAGS=... to cmake commands
export ZOPEN_MAKE_MINIMAL="yes"

export ZOPEN_INSTALL="cmake"
export ZOPEN_INSTALL_OPTS="--install build"
export ZOPEN_INSTALL_MINIMAL="yes"

zopen_check_results()
{
  dir="$1"
  pfx="$2"

  # Check runs after build but before install; verify library in cmake build/ dir.
  if [ -f "./build/libgit2.so" ] || [ -f "./build/libgit2.a" ] || [ -f "./build/libgit2.x" ]; then
    actualFailures=0
    totalTests=1
    expectedFailures=0
  else
    actualFailures=1
    totalTests=1
    expectedFailures=0
  fi

  cat <<ZZ
actualFailures:$actualFailures
totalTests:$totalTests
expectedFailures:$expectedFailures
ZZ
}

zopen_append_to_env()
{
cat <<ZZ
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lgit2"
fi
ZZ
}

zopen_get_version()
{
  echo "${LIBGIT2_VERSION}"
}
